{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The database answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          },
          "503": {
            "description": "The database did not answer within 2 seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "summary": "Liveness and database reachability",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Create an account and sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Exchange email and password for a token pair",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Rotate a refresh token; the old one is revoked",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Revoke the presented refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Revoke every session for the signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      },
      "patch": {
        "operationId": "AuthController_updateMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Update name or avatar",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "ModiModi API",
    "description": "Two-sided dog-walking marketplace. Errors always use the envelope { error: { code, message, requestId } }.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "`degraded` whenever the database is unreachable."
          },
          "uptimeSec": {
            "type": "number",
            "example": 421,
            "description": "Process uptime in whole seconds."
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Result of `SELECT 1` under a 2 second timeout."
          },
          "version": {
            "type": "string",
            "example": "0.1.0",
            "description": "Server package version."
          }
        },
        "required": [
          "status",
          "uptimeSec",
          "db",
          "version"
        ]
      }
    }
  }
}
