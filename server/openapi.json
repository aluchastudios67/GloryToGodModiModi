                }
              }
            }
          }
        },
        "summary": "Add an address",
        "tags": [
          "me"
        ]
      }
    },
    "/me/walker-profile": {
      "get": {
        "operationId": "MeController_walkerProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkerProfileDto"
                }
              }
            }
          }
        },
        "summary": "The walker profile, or null",
        "tags": [
          "me"
        ]
      },
      "put": {
        "operationId": "MeController_putWalkerProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkerProfileDto"
                }
              }
            }
          }
        },
        "summary": "Create or replace the walker profile",
        "tags": [
