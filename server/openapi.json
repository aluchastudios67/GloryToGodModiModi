  },
  "info": {
    "title": "ModiModi API",
    "description": "Two-sided dog-walking marketplace. Errors always use the envelope { error: { code, message, requestId } }.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "`degraded` whenever the database is unreachable."
          },
          "uptimeSec": {
            "type": "number",
            "example": 421,
            "description": "Process uptime in whole seconds."
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Result of `SELECT 1` under a 2 second timeout."
          },
          "version": {
            "type": "string",
            "example": "0.1.0",
            "description": "Server package version."
          }
        },
        "required": [
          "status",
          "uptimeSec",
          "db",
          "version"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "levan@modimodi.ge"
          },
          "name": {
            "type": "string",
            "example": "ლევან ხ."
          },
          "avatarKey": {
            "type": "string",
            "nullable": true
          },
          "isOwner": {
            "type": "boolean"
          },
          "isWalker": {
            "type": "boolean"
          },
          "hasWalkerProfile": {
            "type": "boolean",
            "description": "True once a walker profile exists."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "isOwner",
          "isWalker",
          "hasWalkerProfile",
          "createdAt"
        ]
      },
      "PublicWalkerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "ნინო ბ."
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "CDN URL, resolved from the stored object key."
          },
          "rating": {
            "type": "number",
            "example": 4.9,
            "description": "Denormalised average, 0–5."
          },
          "reviewCount": {
            "type": "number",
            "example": 127
          },
          "price30Tetri": {
            "type": "number",
            "example": 1500,
            "description": "Price for 30 minutes, in tetri."
          },
          "verified": {
            "type": "boolean",
            "description": "True once an admin has verified identity."
          },
          "isAvailableNow": {
            "type": "boolean"
          },
          "districts": {
            "example": [
              "ვაკე"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bio": {
            "type": "string",
            "example": "სამი წელია ვასეირნებ ძაღლებს ვაკეში."
          },
          "distanceKm": {
            "type": "number",
            "nullable": true,
            "description": "Always null until location lands. The field exists so the client contract does not change when it starts being populated."
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "reviewCount",
          "price30Tetri",
          "verified",
          "isAvailableNow",
          "districts",
          "bio"
        ]
      },
      "WalkerPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicWalkerDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as ?cursor= for the next page. Null at the end."
          }
        },
        "required": [
          "items"
        ]
      },
      "DogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "ბობი"
          },
          "breed": {
            "type": "string",
            "example": "ლაბრადორი"
          },
          "birthDate": {
            "type": "string",
            "example": "2023-03-14",
            "description": "Date only. The app renders \"3 წლის\" from this."
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "sizeKg": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "breed",
          "birthDate"
        ]
      },
      "OkDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "example": "სახლი"
          },
          "district": {
            "type": "string",
            "example": "ვაკე"
          },
          "street": {
            "type": "string",
            "example": "აბაშიძის 12"
          },
          "entranceCode": {
            "type": "string",
            "nullable": true,
            "description": "Decrypted, and only ever returned to the address owner."
          }
        },
        "required": [
          "id",
          "label",
          "district",
          "street"
        ]
      },
      "WalkerProfileDto": {
        "type": "object",
        "properties": {
          "bio": {
            "type": "string"
          },
          "price30Tetri": {
            "type": "number",
            "example": 1500,
            "description": "Per 30 minutes, in tetri."
          },
          "districts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isAvailableNow": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "rating": {
            "type": "number",
            "example": 4.9
          },
          "reviewCount": {
            "type": "number",
            "example": 127
          }
        },
        "required": [
          "bio",
          "price30Tetri",
          "districts",
          "isAvailableNow",
          "verified",
          "rating",
          "reviewCount"
        ]
      }
    }
  }
}
