                "schema": {
                  "$ref": "#/components/schemas/WalkerPageDto"
                }
              }
            }
          }
        },
        "summary": "Search walkers, newest-rated first",
        "tags": [
          "walkers"
        ]
      }
    },
    "/walkers/{id}": {
      "get": {
        "operationId": "WalkersController_byId",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicWalkerDto"
                }
              }
            }
          }
        },
        "summary": "One walker",
        "tags": [
          "walkers"
        ]
      }
    },
    "/me/dogs": {
      "get": {
        "operationId": "MeController_dogs",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DogDto"
                  }
                }
              }
            }
          }
        },
        "summary": "The caller's dogs",
        "tags": [
          "me"
        ]
      },
      "post": {
        "operationId": "MeController_addDog",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DogDto"
                }
              }
            }
          }
        },
        "summary": "Add a dog",
        "tags": [
          "me"
        ]
      }
    },
    "/me/dogs/{id}": {
      "patch": {
        "operationId": "MeController_editDog",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DogDto"
                }
              }
            }
          }
        },
        "summary": "Update a dog",
        "tags": [
          "me"
        ]
      },
      "delete": {
        "operationId": "MeController_removeDog",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkDto"
                }
              }
            }
          }
        },
        "summary": "Soft-delete a dog",
        "tags": [
          "me"
        ]
      }
    },
    "/me/addresses": {
      "get": {
        "operationId": "MeController_addresses",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AddressDto"
                  }
                }
              }
            }
          }
        },
        "summary": "The caller's addresses, door codes decrypted",
        "tags": [
