{
  "name": "modimodi-server",
  "version": "0.1.0",
  "private": true,
  "description": "ModiModi API — NestJS on the Fastify adapter",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "npm run build && node dist/openapi.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.6",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.15.47": true,
    "prisma@6.19.3": true
  }
}
