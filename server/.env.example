# ModiModi API — environment
#
# Copy to `.env` and fill in. Every variable below is REQUIRED: the process
# parses this with Zod at boot and exits non-zero naming anything missing.
# There are no defaults on purpose — a server that starts with the wrong
# config fails later, somewhere else, and much more confusingly.

# ---------------------------------------------------------------- runtime ---

# One of: development | test | production
NODE_ENV=development

# Port the HTTP server binds on.
PORT=3000

# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --------------------------------------------------------------- database ---

# Postgres connection string. Must start with postgres:// or postgresql://.
#
# Local development on this machine uses the Homebrew PostgreSQL on 5432.
# The bundled docker-compose.yml publishes Postgres 16 on 5433 instead, so it
# can run alongside a local install without a port clash — if you use Docker,
# change 5432 to 5433 and the credentials to modimodi/modimodi.
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/modimodi_dev

# Used by the test suite. Never point this at a database you care about;
# the suite is free to truncate it.
TEST_DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/modimodi_test

# Believe the X-Forwarded-For header? Only "true" when a proxy YOU control
# terminates TLS in front of this process (Koyeb in production does).
# Left true with no proxy, any caller can rotate the header to reset their
# rate-limit quota indefinitely.
TRUST_PROXY=false

# ------------------------------------------------------------------- cors ---

# Comma-separated absolute origins. "*" is rejected at boot.
# Expo dev server defaults to 8081; add your LAN origin when testing on device.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --------------------------------------------------------------- crypto ---

# 32 bytes, base64. Encrypts Address.entranceCode at rest (AES-256-GCM).
# Generate one with:  npm run keygen
#
# Rotating this makes every existing entranceCode undecryptable — there is no
# key-versioning scheme yet. See DEFERRED.md.
ENCRYPTION_KEY=REPLACE_ME_WITH_32_BYTES_BASE64
